---
const today = new Date();
---

<footer>
  <nav class="footer-links">
    <a href="/about">Tentang Kami</a>
    <a href="/kontak">Kontak</a>
    <a href="/privasi">Kebijakan Privasi</a>
    <a href="/disclaimer">Disclaimer</a>
  </nav>
  <p class="copyright">
    &copy; {today.getFullYear()} PanduanWarga. Seluruh hak cipta dilindungi.
  </p>
</footer>

<style>
  footer {
    margin-top: 4rem;
    padding: 2.5rem 1rem 4.5rem 1rem;
    border-top: 1px solid #e5e7eb;
    text-align: center;
    color: rgb(var(--gray));
    font-size: 1em;
  }

  .footer-links {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1.75rem;
    margin-bottom: 1.25rem;
  }

  .footer-links a {
    color: rgb(var(--black));
    text-decoration: none;
    font-weight: 600;
  }

  .footer-links a:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .copyright {
    margin: 0;
    font-size: 0.95em;
  }
</style>
