---
const today = new Date();
---

<footer>
  <nav class="footer-links" aria-label="Tautan Footer">
    <a href="/about">Tentang Kami</a>
    <a href="/kontak">Kontak</a>
    <a href="/privasi">Kebijakan Privasi</a>
    <a href="/disclaimer">Disclaimer</a>
  </nav>
  <p class="copyright">
    &copy; {today.getFullYear()} PanduanWarga. Seluruh hak cipta dilindungi.
  </p>
</footer>

<style>
  footer {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding: clamp(1.75rem, 4vw, 2.5rem) 1rem clamp(2.5rem, 5vw, 4rem) 1rem;
    border-top: 1px solid #e5e7eb;
    text-align: center;
    color: rgb(var(--gray));
    font-size: 0.95em;
  }

  .footer-links {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    margin-bottom: 1rem;
  }

  .footer-links a {
    color: rgb(var(--black));
    text-decoration: none;
    font-weight: 600;
  }

  .footer-links a:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .copyright {
    margin: 0;
    font-size: 0.9em;
  }
</style>
