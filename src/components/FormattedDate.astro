---
interface Props {
	date: Date;
}

const { date } = Astro.props;
---

<time datetime={date.toISOString()}>
	{date.toLocaleDateString('id-ID', {
		year: 'numeric',
		month: 'short',
		day: 'numeric',
		// pubDate disimpan sebagai tanggal UTC; pakai UTC agar tidak bergeser
		// tergantung zona waktu mesin build.
		timeZone: 'UTC',
	})}
</time>
