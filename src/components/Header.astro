---
import HeaderLink from "./HeaderLink.astro";
---

<header>
  <nav>
    <h2>
      <a href="/" class="brand-logo" aria-label="PanduanWarga - Beranda">
        <img
          src="/favicon.svg?v=2"
          alt=""
          width="32"
          height="32"
          class="brand-icon"
        />
        <span class="brand-text">
          Panduan<span class="brand-accent">Warga</span>
        </span>
      </a>
    </h2>
    <div class="internal-links">
      <HeaderLink href="/">Beranda</HeaderLink>
      <HeaderLink href="/blog">Panduan</HeaderLink>
    </div>
  </nav>
</header>
<style>
  header {
    margin: 0;
    padding: 0 1em;
    background: white;
    box-shadow: 0 2px 8px rgba(var(--black), 5%);
  }
  h2 {
    margin: 0;
    font-size: 1.15em;
  }
  .brand-logo,
  .brand-logo.active {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.65em 0.25em;
    text-decoration: none;
    border-bottom: none;
  }
  .brand-icon {
    width: 32px;
    height: 32px;
    border-radius: 7px;
    flex-shrink: 0;
  }
  .brand-text {
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #0f172a;
  }
  .brand-accent {
    color: #1d4ed8;
  }
  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
  }
  .internal-links a {
    padding: 1em 0.5em;
    color: var(--black);
    border-bottom: 4px solid transparent;
    text-decoration: none;
  }
  .internal-links a.active {
    text-decoration: none;
    border-bottom-color: var(--accent);
  }
  @media (max-width: 480px) {
    header {
      padding: 0 0.75em;
    }
    .brand-icon {
      width: 26px;
      height: 26px;
    }
    .internal-links a {
      padding: 0.85em 0.4em;
      font-size: 0.9em;
    }
  }
</style>
