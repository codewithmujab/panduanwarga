---
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import SideAds from "../components/SideAds.astro";
import AdUnit from "../components/AdUnit.astro";
import { ADSENSE_SLOTS } from "../consts";

type Props = CollectionEntry<"blog">["data"];

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  author = "Tim Redaksi PanduanWarga",
  source,
  sourceUrl,
} = Astro.props;

// Lapisan pertahanan kedua (selain validasi schema): hanya render link http/https.
const safeSourceUrl =
  sourceUrl && /^https?:\/\//i.test(sourceUrl) ? sourceUrl : undefined;
---

<!doctype html>
<html lang="id">
  <head>
    <BaseHead
      title={title}
      description={description}
      image={heroImage}
      type="article"
    />
    <style>
      main {
        width: 100%;
        max-width: 760px;
        margin: 0 auto;
        padding: clamp(1.25rem, 4vw, 2.5rem) clamp(1rem, 4vw, 1.5rem);
      }
      .hero-image {
        width: 100%;
        margin-bottom: 1.25rem;
      }
      .hero-image img {
        display: block;
        margin: 0 auto;
        border-radius: 12px;
        box-shadow: var(--box-shadow);
      }
      .prose {
        width: 100%;
        margin: 0 auto;
        color: rgb(var(--gray-dark));
      }
      .title {
        margin-bottom: 1.25rem;
        padding: 0.25rem 0 0.5rem 0;
        text-align: left;
      }
      .title h1 {
        margin: 0 0 0.75rem 0;
        line-height: 1.25;
      }
      .meta-info {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.35rem 0.55rem;
        margin-bottom: 0.65rem;
        color: rgb(var(--gray));
        font-size: 0.88em;
      }
      .author-badge {
        font-weight: 600;
        color: rgb(var(--black));
      }
      .last-updated-on {
        font-style: italic;
        font-size: 0.9em;
      }
      .source-box {
        margin-top: 2.25rem;
        padding: clamp(1rem, 3vw, 1.25rem) clamp(1rem, 3vw, 1.5rem);
        background-color: #f8fafc;
        border-left: 4px solid #1d4ed8;
        border-radius: 0 8px 8px 0;
        font-size: 0.9em;
      }
      .source-box strong {
        display: block;
        color: #1e293b;
        margin-bottom: 0.35rem;
      }
      .source-box p {
        margin: 0;
        color: #475569;
        line-height: 1.55;
      }
      .source-box a {
        color: #1d4ed8;
        word-break: break-all;
      }
    </style>
  </head>

  <body>
    <Header />
    <SideAds />
    <main>
      <article>
        {
          heroImage && (
            <div class="hero-image">
              <img
                width={1020}
                height={510}
                src={heroImage.src}
                alt={title}
              />
            </div>
          )
        }
        <div class="prose">
          <div class="title">
            <div class="meta-info">
              <span class="author-badge">Oleh: {author}</span>
              <span>&bull;</span>
              <FormattedDate date={pubDate} />
              {
                updatedDate && (
                  <span class="last-updated-on">
                    (Diperbarui: <FormattedDate date={updatedDate} />)
                  </span>
                )
              }
            </div>
            <h1>{title}</h1>
            <hr />
          </div>

          <!-- Iklan 1: Bawah Judul / Atas Artikel -->
          <AdUnit slotId={ADSENSE_SLOTS.articleTop} format="horizontal" />

          <!-- Isi Utama Artikel -->
          <slot />

          <!-- Kotak Sumber Data Resmi -->
          <aside class="source-box" aria-label="Sumber Informasi">
            <strong>Sumber Informasi & Referensi Resmi</strong>
            <p>
              {
                source ? (
                  <>
                    Disusun berdasarkan rujukan resmi dari{" "}
                    <strong>{source}</strong>
                    {safeSourceUrl && (
                      <>
                        {" "}
                        (
                        <a
                          href={safeSourceUrl}
                          target="_blank"
                          rel="noopener noreferrer nofollow"
                        >
                          {safeSourceUrl}
                        </a>
                        )
                      </>
                    )}
                    . Kebijakan dan tarif layanan dapat berubah sewaktu-waktu
                    sesuai ketentuan instansi terkait.
                  </>
                ) : (
                  <>
                    Informasi pada panduan ini dirangkum dari kanal resmi
                    kementerian/lembaga terkait di Indonesia. Selalu periksa
                    portal resmi instansi bersangkutan untuk pembaruan regulasi
                    terbaru.
                  </>
                )
              }
            </p>
          </aside>
        </div>
      </article>
    </main>
    <Footer />
  </body>
</html>
