---
import type { GetStaticPathsOptions } from "astro";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import { getCollection } from "astro:content";
import FormattedDate from "../components/FormattedDate.astro";
import SideAds from "../components/SideAds.astro";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const allPosts = (await getCollection("blog")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
  );

  // Atur jumlah artikel per halaman (misalnya 5 artikel per halaman)
  return paginate(allPosts, { pageSize: 5 });
}

const { page } = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <BaseHead
      title={
        page.currentPage === 1
          ? SITE_TITLE
          : `${SITE_TITLE} - Halaman ${page.currentPage}`
      }
      description={SITE_DESCRIPTION}
      noindex={page.currentPage > 1}
    />
    <style>
      .hero-intro {
        margin-bottom: 1.75rem;
        padding-bottom: 1.5rem;
        border-bottom: 1px solid #e5e7eb;
      }
      .hero-intro p {
        margin-bottom: 0;
        color: #4b5563;
      }
      .section-heading {
        margin-top: 0;
        margin-bottom: 1.25rem;
      }
      .post-feed {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
      }
      .post-item {
        padding: clamp(1rem, 2.5vw, 1.35rem);
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        transition: border-color 0.15s ease, box-shadow 0.15s ease;
      }
      .post-item:hover {
        border-color: #bfdbfe;
        box-shadow: 0 4px 12px rgba(15, 23, 42, 0.05);
      }
      .post-link {
        text-decoration: none;
        display: block;
      }
      .post-link h3 {
        margin: 0 0 0.35rem 0;
        color: #1d4ed8;
        transition: color 0.15s ease;
        line-height: 1.35;
      }
      .post-link:hover h3 {
        color: #1e40af;
        text-decoration: underline;
      }
      .post-meta {
        display: block;
        color: #6b7280;
        font-size: 0.85em;
        margin-bottom: 0.45rem;
      }
      .post-desc {
        margin: 0;
        color: #374151;
        font-size: 0.95em;
        line-height: 1.6;
      }
      .pagination {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        margin-top: 2.25rem;
        padding-top: 1.5rem;
        border-top: 1px solid #e5e7eb;
        gap: 0.75rem;
      }
      .page-btn {
        display: inline-block;
        padding: 0.55rem 1rem;
        border: 1px solid #d1d5db;
        border-radius: 8px;
        text-decoration: none;
        color: #1f2937;
        font-weight: 600;
        font-size: 0.88em;
        transition: all 0.15s ease;
      }
      .page-btn:hover {
        border-color: #1d4ed8;
        color: #1d4ed8;
        background-color: #eff6ff;
      }
      .page-btn.disabled {
        opacity: 0.4;
        pointer-events: none;
      }
      .page-info {
        color: #6b7280;
        font-size: 0.88em;
        text-align: center;
      }
    </style>
  </head>
  <body>
    <Header />
    <SideAds />
    <main>
      {
        page.currentPage === 1 && (
          <section class="hero-intro">
            <h1>Panduan Praktis Layanan Publik & Administrasi</h1>
            <p>
              Temukan langkah-langkah jelas mengurus dokumen kependudukan
              (Dukcapil), cek status bantuan sosial, layanan BPJS Kesehatan &
              Ketenagakerjaan, hingga perpanjangan SIM/STNK secara mandiri.
            </p>
          </section>
        )
      }

      <h2 class="section-heading">
        {
          page.currentPage === 1
            ? "Panduan Terbaru"
            : `Panduan Layanan Publik (Halaman ${page.currentPage})`
        }
      </h2>

      <ul class="post-feed">
        {
          page.data.map((post) => (
            <li class="post-item">
              <a href={`/blog/${post.id}/`} class="post-link">
                <h3>{post.data.title}</h3>
              </a>
              <small class="post-meta">
                <FormattedDate date={post.data.pubDate} />
              </small>
              <p class="post-desc">{post.data.description}</p>
            </li>
          ))
        }
      </ul>

      {
        page.lastPage > 1 && (
          <nav class="pagination" aria-label="Navigasi Halaman">
            {page.url.prev ? (
              <a href={page.url.prev} class="page-btn">
                &larr; Sebelumnya
              </a>
            ) : (
              <span class="page-btn disabled">&larr; Sebelumnya</span>
            )}

            <span class="page-info">
              Halaman {page.currentPage} dari {page.lastPage}
            </span>

            {page.url.next ? (
              <a href={page.url.next} class="page-btn">
                Selanjutnya &rarr;
              </a>
            ) : (
              <span class="page-btn disabled">Selanjutnya &rarr;</span>
            )}
          </nav>
        )
      }
    </main>
    <Footer />
  </body>
</html>
