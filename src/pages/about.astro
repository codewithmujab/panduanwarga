---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<!doctype html>
<html lang="id">
  <head>
    <BaseHead
      title="Tentang Kami - PanduanWarga"
      description="Profil dan tujuan portal informasi PanduanWarga."
    />
  </head>
  <body>
    <Header />
    <main>
      <h1>Tentang PanduanWarga</h1>
      <p>
        <strong>PanduanWarga</strong> adalah portal informasi independen yang
        menyajikan panduan praktis seputar layanan publik, administrasi
        kependudukan (Dukcapil), jaminan sosial (BPJS), bantuan sosial
        pemerintah, serta layanan transportasi di Indonesia.
      </p>
      <p>
        Kami menyusun setiap panduan dengan bahasa yang sederhana, ringkas, dan
        terstruktur berdasarkan rujukan informasi resmi instansi terkait agar
        masyarakat lebih mudah memahami persyaratan dan alur pengurusan dokumen
        secara mandiri.
      </p>
    </main>
    <Footer />
  </body>
</html>
