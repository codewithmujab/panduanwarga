---
import type { GetStaticPathsOptions } from "astro";
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../../consts";
import { getCollection } from "astro:content";
import FormattedDate from "../../components/FormattedDate.astro";
import { Image } from "astro:assets";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const allPosts = (await getCollection("blog")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
  );

  return paginate(allPosts, { pageSize: 6 });
}

const { page } = Astro.props;

// Kumpulkan daftar unik Bulan-Tahun untuk dropdown arsip
const allPostsForArchive = await getCollection("blog");
const archiveMap = new Map<string, { label: string; count: number }>();

const monthNames = [
  "Januari",
  "Februari",
  "Maret",
  "April",
  "Mei",
  "Juni",
  "Juli",
  "Agustus",
  "September",
  "Oktober",
  "November",
  "Desember",
];

allPostsForArchive
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .forEach((post) => {
    const d = new Date(post.data.pubDate);
    // Pakai UTC agar sama dengan search-index.json (tidak bergeser karena zona waktu build).
    const key = `${d.getUTCFullYear()}-${String(d.getUTCMonth() + 1).padStart(2, "0")}`;
    const label = `${monthNames[d.getUTCMonth()]} ${d.getUTCFullYear()}`;
    const existing = archiveMap.get(key);
    archiveMap.set(key, { label, count: (existing?.count || 0) + 1 });
  });

const archiveOptions = Array.from(archiveMap.entries());
---

<!doctype html>
<html lang="id">
  <head>
    <BaseHead
      title={
        page.currentPage === 1
          ? `Panduan - ${SITE_TITLE}`
          : `Panduan (Halaman ${page.currentPage}) - ${SITE_TITLE}`
      }
      description={SITE_DESCRIPTION}
    />
    <style>
      main {
        max-width: 960px;
      }
      .filter-bar {
        display: grid;
        grid-template-columns: 2fr 1.2fr 1fr;
        gap: 0.75rem;
        margin-bottom: 1.75rem;
        padding: clamp(0.85rem, 2.5vw, 1.15rem);
        background-color: #f9fafb;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
      }
      .filter-group {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
        min-width: 0;
      }
      .filter-group label {
        font-size: 0.8em;
        font-weight: 600;
        color: #4b5563;
      }
      .filter-input {
        width: 100%;
        padding: 0.55rem 0.75rem;
        border: 1px solid #d1d5db;
        border-radius: 6px;
        font-size: 0.9em;
        font-family: inherit;
        background-color: #ffffff;
      }
      .filter-input:focus {
        outline: none;
        border-color: var(--accent);
      }
      .reset-btn {
        margin-bottom: 1.15rem;
        background: none;
        border: none;
        color: var(--accent);
        font-size: 0.85em;
        font-weight: 600;
        cursor: pointer;
        padding: 0;
        display: none;
      }
      .reset-btn:hover {
        text-decoration: underline;
      }
      .status-banner {
        margin-bottom: 1rem;
        font-size: 0.9em;
        color: #4b5563;
        display: none;
      }

      /* Grid Responsif Daftar Panduan */
      ul.blog-list {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1.25rem;
        list-style-type: none;
        margin: 0;
        padding: 0;
      }
      ul.blog-list li {
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        padding: clamp(1rem, 2.5vw, 1.35rem);
        transition: border-color 0.15s ease, box-shadow 0.15s ease;
      }
      ul.blog-list li:hover {
        border-color: #bfdbfe;
        box-shadow: 0 4px 12px rgba(15, 23, 42, 0.05);
      }
      ul.blog-list li * {
        text-decoration: none;
        transition: 0.15s ease;
      }
      ul.blog-list li img {
        margin-bottom: 0.65rem;
        border-radius: 8px;
        width: 100%;
      }
      ul.blog-list li a {
        display: flex;
        flex-direction: column;
        gap: 0.45rem;
        height: 100%;
      }
      .title {
        margin: 0;
        color: rgb(var(--black));
        line-height: 1.35;
        font-size: clamp(1.02rem, 0.95rem + 0.35vw, 1.18rem);
      }
      .date {
        margin: 0;
        color: rgb(var(--gray));
        font-size: 0.85em;
      }
      ul.blog-list li a:hover .title {
        color: var(--accent);
      }

      /* Paginasi */
      .pagination {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        margin-top: 2.5rem;
        padding-top: 1.5rem;
        border-top: 1px solid #e5e7eb;
        gap: 0.75rem;
      }
      .page-btn {
        display: inline-block;
        padding: 0.55rem 1rem;
        border: 1px solid #d1d5db;
        border-radius: 8px;
        text-decoration: none;
        color: #1f2937;
        font-weight: 600;
        font-size: 0.88em;
        transition: all 0.15s ease;
      }
      .page-btn:hover {
        border-color: var(--accent);
        color: var(--accent);
        background-color: #eff6ff;
      }
      .page-btn.disabled {
        opacity: 0.4;
        pointer-events: none;
      }
      .page-info {
        color: #6b7280;
        font-size: 0.88em;
        text-align: center;
      }

      /* Tablet */
      @media (max-width: 820px) {
        .filter-bar {
          grid-template-columns: 1fr 1fr;
        }
        .filter-group:first-child {
          grid-column: 1 / -1;
        }
      }

      /* Mobile */
      @media (max-width: 600px) {
        .filter-bar {
          grid-template-columns: 1fr;
        }
        ul.blog-list {
          grid-template-columns: 1fr;
          gap: 1rem;
        }
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <!-- Bar Pencarian & Filter Arsip -->
      <section class="filter-bar" aria-label="Pencarian dan Arsip">
        <div class="filter-group">
          <label for="searchInput">Cari Panduan</label>
          <input
            type="search"
            id="searchInput"
            class="filter-input"
            placeholder="Ketik kata kunci (misal: SIM, BPJS, Bansos)..."
          />
        </div>

        <div class="filter-group">
          <label for="monthFilter">Arsip Per Bulan</label>
          <select id="monthFilter" class="filter-input">
            <option value="">Semua Bulan</option>
            {
              archiveOptions.map(([key, info]) => (
                <option value={key}>
                  {info.label} ({info.count})
                </option>
              ))
            }
          </select>
        </div>

        <div class="filter-group">
          <label for="dateFilter">Filter Per Tanggal</label>
          <input type="date" id="dateFilter" class="filter-input" />
        </div>
      </section>

      <div id="filterStatus" class="status-banner"></div>
      <button id="resetFilterBtn" class="reset-btn" type="button">
        &times; Reset pencarian & filter
      </button>

      <!-- Daftar Artikel -->
      <section>
        <ul id="staticPostList" class="blog-list">
          {
            page.data.map((post) => (
              <li>
                <a href={`/blog/${post.id}/`}>
                  {post.data.heroImage && (
                    <Image
                      width={720}
                      height={360}
                      src={post.data.heroImage}
                      alt={post.data.title}
                    />
                  )}
                  <h4 class="title">{post.data.title}</h4>
                  <p class="date">
                    <FormattedDate date={post.data.pubDate} />
                  </p>
                </a>
              </li>
            ))
          }
        </ul>

        <!-- Daftar Hasil Pencarian / Filter Dinamis -->
        <ul
          id="dynamicResultList"
          class="blog-list"
          style="display: none;"
        ></ul>
      </section>

      <!-- Paginasi -->
      {
        page.lastPage > 1 && (
          <nav
            id="paginationNav"
            class="pagination"
            aria-label="Navigasi Halaman Blog"
          >
            {page.url.prev ? (
              <a href={page.url.prev} class="page-btn">
                &larr; Sebelumnya
              </a>
            ) : (
              <span class="page-btn disabled">&larr; Sebelumnya</span>
            )}

            <span class="page-info">
              Halaman {page.currentPage} dari {page.lastPage}
            </span>

            {page.url.next ? (
              <a href={page.url.next} class="page-btn">
                Selanjutnya &rarr;
              </a>
            ) : (
              <span class="page-btn disabled">Selanjutnya &rarr;</span>
            )}
          </nav>
        )
      }
    </main>
    <Footer />

    <script is:inline>
      let indexPromise = null;
      let requestId = 0;

      const searchInput = document.getElementById("searchInput");
      const monthFilter = document.getElementById("monthFilter");
      const dateFilter = document.getElementById("dateFilter");
      const resetBtn = document.getElementById("resetFilterBtn");
      const statusBanner = document.getElementById("filterStatus");
      const staticList = document.getElementById("staticPostList");
      const dynamicList = document.getElementById("dynamicResultList");
      const paginationNav = document.getElementById("paginationNav");

      // Atribut scope CSS Astro (data-astro-cid-xxx) supaya elemen hasil
      // pencarian mendapat style yang sama dengan daftar statis.
      const scopeAttr = Array.from(dynamicList.attributes).find((a) =>
        a.name.startsWith("data-astro-cid-"),
      )?.name;

      function el(tag, className, text) {
        const node = document.createElement(tag);
        if (scopeAttr) node.setAttribute(scopeAttr, "");
        if (className) node.className = className;
        // textContent = aman dari XSS (tidak pernah diparse sebagai HTML)
        if (text !== undefined) node.textContent = text;
        return node;
      }

      function loadIndex() {
        if (!indexPromise) {
          indexPromise = fetch("/search-index.json")
            .then((res) => {
              if (!res.ok) throw new Error("HTTP " + res.status);
              return res.json();
            })
            .catch((err) => {
              indexPromise = null; // izinkan coba lagi
              throw err;
            });
        }
        return indexPromise;
      }

      function formatIndoDate(dateStr) {
        const d = new Date(dateStr);
        return d.toLocaleDateString("id-ID", {
          day: "numeric",
          month: "short",
          year: "numeric",
          timeZone: "UTC",
        });
      }

      function showMessage(text) {
        const li = el("li", "", text);
        li.style.cssText =
          "grid-column: 1 / -1; padding: 1.5rem; color: #6b7280; text-align: center;";
        dynamicList.replaceChildren(li);
      }

      async function applyFilters() {
        const current = ++requestId;
        const query = searchInput.value.trim().toLowerCase();
        const selectedMonth = monthFilter.value;
        const selectedDate = dateFilter.value;

        const isFiltering =
          query !== "" || selectedMonth !== "" || selectedDate !== "";

        if (!isFiltering) {
          staticList.style.display = "grid";
          dynamicList.style.display = "none";
          statusBanner.style.display = "none";
          resetBtn.style.display = "none";
          if (paginationNav) paginationNav.style.display = "flex";
          return;
        }

        staticList.style.display = "none";
        if (paginationNav) paginationNav.style.display = "none";
        dynamicList.style.display = "grid";
        statusBanner.style.display = "block";
        resetBtn.style.display = "inline-block";

        let data;
        try {
          data = await loadIndex();
        } catch (err) {
          if (current !== requestId) return;
          console.error("Gagal memuat indeks pencarian:", err);
          statusBanner.textContent =
            "Gagal memuat data pencarian. Periksa koneksi internet lalu coba lagi.";
          dynamicList.replaceChildren();
          return;
        }
        // Abaikan hasil lama jika pengguna sudah mengetik lagi.
        if (current !== requestId) return;

        const filtered = data.filter((item) => {
          const matchQuery =
            !query ||
            String(item.title).toLowerCase().includes(query) ||
            String(item.description).toLowerCase().includes(query);
          const matchMonth = !selectedMonth || item.yearMonth === selectedMonth;
          const matchDate = !selectedDate || item.fullDate === selectedDate;
          return matchQuery && matchMonth && matchDate;
        });

        statusBanner.textContent = `Menampilkan ${filtered.length} panduan yang sesuai.`;

        if (filtered.length === 0) {
          showMessage(
            "Tidak ada panduan yang cocok dengan pencarian atau tanggal tersebut.",
          );
          return;
        }

        const frag = document.createDocumentFragment();
        for (const post of filtered) {
          const li = el("li");
          const a = el("a");
          a.href = "/blog/" + encodeURI(String(post.id)) + "/";
          a.append(
            el("h4", "title", String(post.title)),
            el("p", "date", formatIndoDate(post.pubDate)),
          );
          li.append(a);
          frag.append(li);
        }
        dynamicList.replaceChildren(frag);
      }

      searchInput.addEventListener("input", applyFilters);
      monthFilter.addEventListener("change", () => {
        if (monthFilter.value) dateFilter.value = "";
        applyFilters();
      });
      dateFilter.addEventListener("change", () => {
        if (dateFilter.value) monthFilter.value = "";
        applyFilters();
      });
      resetBtn.addEventListener("click", () => {
        searchInput.value = "";
        monthFilter.value = "";
        dateFilter.value = "";
        applyFilters();
      });
    </script>
  </body>
</html>
